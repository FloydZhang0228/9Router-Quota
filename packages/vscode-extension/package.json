{
  "name": "9router-quota",
  "displayName": "9Router Quota",
  "description": "在 VSCode 底部面板查看 9Router 各 AI 账号的配额用量",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "9router-quota.open", "title": "打开 9Router 配额面板" },
      { "command": "9router-quota.refresh", "title": "刷新 9Router 配额", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "panel": [
        { "id": "nineRouterQuota", "title": "9Router", "icon": "$(pulse)" }
      ]
    },
    "views": {
      "nineRouterQuota": [
        { "type": "webview", "id": "9router-quota.view", "name": "配额" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "9router-quota.refresh", "when": "view == 9router-quota.view", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "9Router Quota",
      "properties": {
        "9routerQuota.baseUrl": {
          "type": "string",
          "default": "",
          "description": "9Router 服务地址，例如 http://9router.example.com"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@9router-quota/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
