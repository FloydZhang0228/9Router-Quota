{
  "name": "9router-quota",
  "displayName": "9Router Quota",
  "description": "在 VSCode 侧边栏查看 9Router 各 AI 账号的配额用量",
  "version": "0.1.1",
  "publisher": "FloydZhang0228",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FloydZhang0228/9Router-Quota.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["9router", "quota", "usage", "claude", "配额"],
  "activationEvents": ["onStartupFinished"],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "9router-quota.open", "title": "打开 9Router 配额面板" },
      { "command": "9router-quota.refresh", "title": "刷新 9Router 配额", "icon": "$(refresh)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "nineRouterQuota", "title": "9Router Quota", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "nineRouterQuota": [
        { "type": "webview", "id": "9router-quota.view", "name": "", "retainContextWhenHidden": true }
      ]
    },
    "configuration": {
      "title": "9Router Quota",
      "properties": {
        "9routerQuota.baseUrl": {
          "type": "string",
          "default": "",
          "description": "9Router 服务地址，例如 http://9router.example.com"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "node esbuild.js --production && npx @vscode/vsce package --no-dependencies --readme-path README.packaged.md --no-rewrite-relative-links",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@9router-quota/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}
